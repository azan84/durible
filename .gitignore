
# STL source — build input, not runtime asset
*.stl
node_modules/
package*.json

# admin-manage build tooling — keep package.json (needed to rebuild) even
# though package*.json is ignored globally above; node_modules stays ignored.
!/admin-manage/package.json

# local secrets and state for wrangler pages dev
.dev.vars
.wrangler/

# ordo-chat Worker (the "Ask Ordo" assistant) — keep its manifest and lockfile.
!/workers/ordo-chat/package.json
!/workers/ordo-chat/package-lock.json
